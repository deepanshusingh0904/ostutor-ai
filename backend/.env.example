# ----- Backend (copy to backend/.env) -----
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin account created on first start
ADMIN_EMAIL=admin@ostutor.ai
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Course Administrator

# Any OpenAI-compatible provider (OpenAI, Azure, Groq, Together, Ollama, LM Studio, vLLM ...)
# Leave LLM_API_KEY empty to run in offline mode: answers are assembled from retrieved passages.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# RAG
EMBEDDING_BACKEND=auto            # auto | sentence-transformers | hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.12
